# === Required ===
# JWT secret key (pakai string random panjang untuk production)
JWT_KEY=your_jwt_secret_here_change_in_production

# Database connection string (Supabase/PostgreSQL)
DATABASE_URL=postgresql://postgres:***@host:5432/dbname

# Node environment
NODE_ENV=production

# === AI Scoring ===
# DeepSeek API key untuk AI-powered scoring
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# === Optional ===
# PORT (Railway injects this automatically, set manually only for local dev)
# PORT=3000
